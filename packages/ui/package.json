{
  "name": "@mochikin/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared UI components for MOCHIKIN-APPS ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./points": {
      "types": "./dist/points/index.d.ts",
      "import": "./dist/points/index.js",
      "require": "./dist/points/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0 || ^18.0.0",
    "react-dom": "^19.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.2.0"
  }
}
