# Environment variables for Vercel / Production deployment
#
# Salin file ini menjadi `.env.local` untuk development, lalu isi nilainya.
# JANGAN commit `.env.local` ke repository.

# Wajib — Secret key untuk signing session (minimal 32 karakter)
STOKIS_API_KEY=<your-secret-key-min-32-char>

# Supabase PostgreSQL Database (Wajib)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Opsional — URL publik aplikasi
APP_URL=https://your-app.vercel.app
