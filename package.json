{
  "name": "mochikin-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MOCHIKIN-APPS Modular Ecosystem (Ala Pola Odoo 20)",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
