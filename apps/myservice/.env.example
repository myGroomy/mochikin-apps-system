# ==============================================================================
# MYSERVICE ENVIRONMENT CONFIGURATION (COMPATIBLE WITH MYLAUNCHER)
# ==============================================================================

# Supabase PostgreSQL Database (Required)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# SSO Handoff & Session Secrets (Must match across all apps)
LAUNCHER_SSO_SHARED_SECRET=your-shared-secret-at-least-32-chars
LAUNCHER_SESSION_SECRET=your-session-secret-at-least-32-chars
SESSION_SECRET=your-session-secret-at-least-32-chars

# Security Parameters
SESSION_EXPIRES_IN_SECONDS=28800
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=5
SESSION_COOKIE_DOMAIN=

# Ecosystem Sibling App URLs
NEXT_PUBLIC_STOKIS_URL=https://stokis-project.vercel.app
NEXT_PUBLIC_MYCUSTOMER_URL=https://retain-ly.vercel.app
NEXT_PUBLIC_MYCHECK_URL=https://mycheck-two.vercel.app
NEXT_PUBLIC_MYPERFORMANCE_URL=https://myperformance.vercel.app
