# Upstash Redis (opsional — cache server-side.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase PostgreSQL Database (Wajib)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must be at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=
LAUNCHER_SSO_SHARED_SECRET=

# Optional retention defaults
NEXT_PUBLIC_DEFAULT_CHURN_ACTIVE_DAYS=30
NEXT_PUBLIC_DEFAULT_CHURN_AT_RISK_DAYS=60
