# Environment variables for Vercel / Production deployment
#
# Salin file ini menjadi `.env.local` untuk development, lalu isi nilainya.
# JANGAN commit `.env.local` ke repository.

# Wajib — Secret key untuk signing session (minimal 32 karakter)
STOKIS_API_KEY=<your-secret-key-min-32-char>

# Wajib — Email Service Account dari Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account>@<project-id>.iam.gserviceaccount.com

# Wajib — Private Key dari file JSON Service Account.
# Pastikan newline di-escape sebagai \n literal (kode otomatis normalisasi).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

# Wajib — ID Google Sheet Registry (berisi sheet Daftar_Cabang, Users, dll.)
REGISTRY_SPREADSHEET_ID=<registry-spreadsheet-id>

# Opsional — Endpoint Google Apps Script untuk upload file XLSX ke Google Drive.
# Diperlukan hanya untuk upload laporan ke Drive. Jika dikosongkan, upload ke
# Drive tidak berjalan (fitur laporan XLSX di Drive nonaktif).
APPS_SCRIPT_URL=<your-appscript-deployment-url>

# Opsional — URL publik aplikasi (dipakai untuk link fallback XLSX/regenerate)
APP_URL=https://your-app.vercel.app

# Opsional — ID folder induk Google Drive (default bisa diatur di sheet Settings_Global)
FOLDER_DRIVE_INDUK=<folder-drive-induk-id>