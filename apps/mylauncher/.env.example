# Copy to .env.local. Never commit real values.
# Full-spreadsheet mode: no Supabase. Share REGISTRY_SPREADSHEET_ID with the service account (Editor).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
LAUNCHER_SESSION_SECRET=generate-a-long-random-secret
LAUNCHER_SSO_SHARED_SECRET=shared-secret-with-stokis-and-mycustomer
REGISTRY_SPREADSHEET_ID=11Hlits3ugvw9LtbeKGnTnO3_rm4erdvM-dqf1vFcuak
FOLDER_DRIVE_INDUK=
SESSION_EXPIRES_IN_SECONDS=3600
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=5
# Shared cookie domain for a future common production domain. Leave empty for localhost
# and separate *.vercel.app deployments; sibling Vercel apps cannot share cookies.
SESSION_COOKIE_DOMAIN=
